{
  "name": "a-ripple-song-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:icons && npm run build:css && npm run build:js",
    "build:icons": "node bin/copy-icons.mjs",
    "build:css": "postcss \"resources/assets/css/player/*.css\" --dir public/dist/skins --no-map",
    "build:js": "esbuild resources/assets/js/player/player.js --bundle --minify --format=iife --target=es2019 --outfile=public/dist/player.js",
    "watch:css": "postcss \"resources/assets/css/player/*.css\" --dir public/dist/skins --no-map --watch",
    "watch:js": "esbuild resources/assets/js/player/player.js --bundle --format=iife --target=es2019 --outfile=public/dist/player.js --watch"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.7.50",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.63.0",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "postcss-prefix-selector": "^2.2.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "howler": "^2.2.4"
  }
}
